/* coron.keymap */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        /* Note: Key positions have shifted due to added columns.
           You will need to recalculate these indices later. */

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            label = "mt2";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
        };

        hold_mt: hold_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_MT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_default {
            bindings = <
&none  &kp Q                      &kp W  &kp E  &kp R                        &kp T        &kp Y              &kp U                         &lt 5 I                 &kp O                &kp P      &none
&none  &mt2 LEFT_CONTROL A        &kp S  &kp D  &kp F                        &kp G        &kp LS(LG(S))      &kp MINUS                     &kp H                   &kp J                &kp K      &kp L    &mt2 RIGHT_CONTROL SEMI  &none
&none  &mt LEFT_SHIFT Z           &kp X  &kp C  &kp V                        &kp B        &mkp MB1           &kp SEMICOLON                 &kp N                   &kp M                &kp COMMA  &kp DOT  &lt 2 SLASH              &none
&none  &mt2 RIGHT_ALT LANGUAGE_1  &none  &none  &lt_to_layer_0 3 INT_HENKAN  &lt 0 SPACE  &mt2 LEFT_GUI TAB  &hold_mt RIGHT_GUI BACKSPACE  &mt2 RIGHT_SHIFT ENTER  &mt2 LEFT_ALT LANG2  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
            label = "mDefault";
        };

        win_default {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                     &trans                   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                     &trans                   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                     &trans                   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &hold_mt LEFT_CONTROL TAB  &mt2 LEFT_GUI BACKSPACE  &trans  &trans  &trans
            >;

            label = "wDefault";
            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        numbers {
            bindings = <
&trans  &kp SLASH                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS  &kp CARET                &kp BACKSPACE   &kp DELETE             &kp TAB        &kp MINUS     &trans
&trans  &kp ASTERISK                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS   &kp LC(LA(KP_NUMBER_0))  &kp UNDERSCORE  &kp LEFT               &kp DOWN       &kp UP_ARROW  &kp RIGHT  &kp ENTER  &trans
&trans  &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL  &trans                   &trans          &kp HOME               &kp PAGE_DOWN  &kp PG_UP     &kp END    &trans     &trans
&trans  &trans                      &trans           &trans           &kp SPACE        &trans     &trans                   &trans          &mt2 RSHIFT LS(ENTER)  &trans         &trans
            >;
        };

        symbols {
            bindings = <
&none  &kp QUESTION               &kp DOUBLE_QUOTES  &kp EXCLAMATION  &kp BACKSPACE  &kp TILDE      &none          &kp UNDER      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERCENT       &none
&none  &kp AT                     &kp SINGLE_QUOTE   &kp DOLLAR       &kp DELETE     &kp SLASH      &kp LS(LG(S))  &kp MINUS      &kp HASH              &none                  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_CONTROL  &none
&none  &kp LEFT_SHIFT             &kp GRAVE          &kp CARET        &kp PIPE       &kp BACKSLASH  &mkp MB1       &kp SEMICOLON  &kp ASTERISK          &kp AMPS               &kp LEFT_BRACE    &kp RIGHT_BRACE    &mo 4             &none
&none  &mt2 RIGHT_ALT LANGUAGE_1  &none              &none            &none          &trans         &trans         &trans         &trans                &mt2 LEFT_ALT LANG2    &none
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
            label = "symbols";
        };

        func_navi {
            bindings = <
&trans  &none                   &kp F7  &kp F8  &kp F9  &kp F12  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT  &none             &trans
&trans  &kp C_PP                &kp F4  &kp F5  &kp F6  &kp F11  &trans          &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_UP      &mmv MOVE_RIGHT  &trans  &trans
&trans  &mt2 LEFT_SHIFT C_STOP  &kp F1  &kp F2  &kp F3  &kp F10  &trans          &trans          &trans          &kp LEFT_GUI     &kp LEFT_CONTROL  &kp RIGHT_ALT    &trans  &trans
&trans  &trans                  &trans  &trans  &trans  &trans   &trans          &mkp MB1        &mkp MB2        &trans           &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mac_bt_shortcuts {
            bindings = <
&trans  &sys_reset           &bootloader   &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LG(LS(N5))  &none   &to 0   &to 1   &bootloader  &sys_reset  &trans
&trans  &trans               &bt BT_SEL 4  &out OUT_TOG          &none                 &none           &trans  &trans  &trans  &trans       &trans      &bt BT_CLR  &bt BT_CLR_ALL  &none
&trans  &bt BT_SEL 0         &bt BT_SEL 1  &bt BT_SEL 2          &bt BT_SEL 3          &none           &trans  &trans  &none   &trans       &trans      &trans      &trans          &none
&trans  &kp LG(LA(C_POWER))  &trans        &trans                &trans                &trans          &trans  &trans  &trans  &trans       &none
            >;

            label = "system_layer";
        };

        win_bt_shortcuts {
            bindings = <
&trans  &sys_reset    &bootloader   &kp LG(PRINTSCREEN)  &kp LS(LG(S))  &kp LG(LS(S))  &none   &to 0   &to 1   &bootloader  &sys_reset  &trans
&trans  &trans        &bt BT_SEL 4  &out OUT_TOG         &none          &none          &trans  &trans  &trans  &trans       &trans      &bt BT_CLR  &bt BT_CLR_ALL  &none
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2         &bt BT_SEL 3   &none          &trans  &trans  &none   &trans       &trans      &trans      &trans          &none
&trans  &kp LG(L)     &trans        &trans               &trans         &trans         &trans  &trans  &trans  &trans       &none
            >;

            label = "system_laye";
        };
    };
};
